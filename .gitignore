# tests/demo-b/arcade: the arcade's work RAM at known frames (MAME, fresh NVRAM) -- the
# oracle the demo check diffs against. Sega-derived: excluded from the public branch.
!tests/demo-b/arcade/aw_*.bin

# the demo gate's scratch dumps (tests/demo-b/check_demo.py, DEMO_WORK)
tests/demo-b/work/

# tests/demo-b/picbase: the PICTURE baselines the gate compares the composed screen band
# against -- the only check that sees what was DRAWN, as opposed to the records (work RAM)
# and the FB staging (the tilemap). *.bin above excludes them by default, and a baseline
# that is not committed is not a baseline.
!tests/demo-b/picbase/pic_*.bin

